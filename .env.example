# Copy to .env.local for development. Never commit .env.local.

# --- Database -------------------------------------------------------------
# Matches docker-compose.yml (port 5434 to avoid clashing with a locally-installed
# PostgreSQL on 5432). On the VPS, point this at the Dokploy Postgres service.
DATABASE_URL="postgresql://marley:marley@localhost:5434/marley"

# --- Auth (Auth.js) -------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public origin of the app. Required in production for correct callback URLs.
AUTH_URL="http://localhost:3000"

# --- Email ----------------------------------------------------------------
# In development, leave RESEND_API_KEY empty to route mail to MailHog (localhost:1025).
RESEND_API_KEY=""
EMAIL_FROM="Marley Buckles <orders@example.com>"
# Where order-review notifications for Marley go.
ADMIN_NOTIFICATION_EMAIL=""

# --- Image storage (Cloudflare R2, S3-compatible) --------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL that serves the bucket (an R2 custom domain, or the r2.dev subdomain).
# Also whitelisted for next/image — see next.config.ts.
NEXT_PUBLIC_ASSET_HOST=""

# --- AI image generation --------------------------------------------------
OPENAI_API_KEY=""
# Images a single design may generate per rolling 24h (2 per press of Generate).
AI_MAX_IMAGES_PER_DESIGN_PER_DAY="8"

# --- Anti-abuse (Cloudflare Turnstile) ------------------------------------
# Leave empty in development to skip the captcha check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Payments (Stripe) ----------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Local image storage --------------------------------------------------
# Where generated and uploaded images are written. On the VPS point this at a
# mounted Docker volume so images survive redeploys. Defaults to ./.storage
STORAGE_DIR=""
# Set to "mock" to generate placeholder designs without calling (or paying) OpenAI.
AI_PROVIDER=""
